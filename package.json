{
  "name": "todo_app",
  "version": "1.0.0",
  "description": "Applicazione ToDo con autenticazione utenti basata su Node.js, Express e MongoDB. Permette di registrarsi, accedere e gestire liste di attività personali in modo sicuro tramite un’interfaccia dinamica realizzata con EJS.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "NODE_ENV=development node src/server.js",
    "format": "prettier --write \"**/*.{js,jsx,json,css,md}\""
  },
  "keywords": [
    "todo",
    "express",
    "mongodb",
    "auth"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-mongo": "^5.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-flash": "^0.0.2",
    "express-session": "^1.17.3",
    "method-override": "^3.0.0",
    "mongoose": "^8.3.2"
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  }
}
